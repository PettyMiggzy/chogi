# ── REQUIRED ────────────────────────────────────────
# Wallet where Monorail fees land. Must match PRIVATE_KEY when ARMED=true.
TREASURY_ADDR=0x4601a7f665ca13c40d2236b8b9ff1e4b87226351

# Private key — only set when ready to flip ARMED=true.
# NEVER commit this file with a real key. Use a wallet that ONLY holds
# trading fees + ~10 MON for gas. Sweep excess to cold storage manually.
PRIVATE_KEY=

# ── SAFETY ──────────────────────────────────────────
# Default false → DRY-RUN mode (logs intent, signs nothing).
# Flip to true ONLY after reviewing several dry-run cycles.
ARMED=false

# ── TUNING ──────────────────────────────────────────
# How often to tick (ms). Default: 10 min.
TICK_MS=600000

# Fee tokens worth less than this USD aren't worth sweeping (gas cost).
DUST_USD_FLOOR=1

# Bot tolerates more slippage than UI swaps since it's not user-facing.
SLIPPAGE_BPS=300

# RPC endpoints, comma-separated. First is primary; rest are failover.
RPC_URLS=https://rpc.monad.xyz,https://monad-mainnet.public.blastapi.io

# Where to write stats + log (relative paths fine).
STATS_PATH=./burn-stats.json
LOG_PATH=./burn-log.jsonl
